{
  "expo": {
    "name": "LAYA Market",
    "slug": "laya-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#01040B",
    "splash": {"image":"./assets/splash.png","resizeMode":"contain","backgroundColor":"#01040B"},
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.laya.market",
      "versionCode": 1,
      "adaptiveIcon": {"foregroundImage":"./assets/adaptive-icon.png","backgroundColor":"#01040B"},
      "permissions": ["ACCESS_COARSE_LOCATION","ACCESS_FINE_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "com.laya.market",
      "infoPlist": {"NSLocationWhenInUseUsageDescription":"LAYA Market usa tu ubicación para mostrar comercios cercanos, confirmar direcciones y calcular entregas."}
    },
    "plugins": [
      ["expo-build-properties", {"android": {"compileSdkVersion":36,"targetSdkVersion":36,"minSdkVersion":24}}],
      ["expo-location", {"locationWhenInUsePermission":"Permite que LAYA Market use tu ubicación para encontrar comercios cercanos y confirmar tu dirección."}]
    ],
    "extra": {"eas": {"projectId":"REPLACE_WITH_EAS_PROJECT_ID"}}
  }
}
